OPENAI_API_KEY=
# Optional; agents still respond without live research.
EXA_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Reasoning effort (none|minimal|low|medium|high|xhigh|max). Lower = faster.
# Router only picks who speaks next (no tools) — minimal keeps it quick.
OPENAI_ROUTER_EFFORT=minimal
# Optional: point routing at a lighter/faster model; blank = use OPENAI_MODEL.
OPENAI_ROUTER_MODEL=
# Experts write the concise replies — low balances speed and quality.
OPENAI_AGENT_EFFORT=low
AGNO_API_TOKEN=
